# Ghostfolio instance URL (no trailing slash)
GHOSTFOLIO_HOST=https://ghostfol.io/

# Your Ghostfolio access token (from Settings page)
GHOSTFOLIO_TOKEN=your_access_token_here

# Base URL path (for reverse proxy sub-path deployment, e.g. /statsfolio)
BASE_URL=/

# Base URL path (for reverse proxy sub-path deployment)
# Example: BASE_URL=/statsfolio if served at https://your-domain.com/statsfolio
BASE_URL=/
